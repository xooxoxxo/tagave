# Copy to .deploy.env (gitignored). Hosts are ssh aliases from ~/.ssh/config.
APP_HOST=my-docker-host
APP_DIR=/opt/tagave
APP_HEALTH_URL=http://my-docker-host:3100/api/v1/health
WORKER_HOST=my-worker-host
WORKER_DIR=/opt/tagave
WORKER_NODE_BIN=/usr/local/bin
WORKER_DATABASE_URL=postgres://liner:liner@db-host:5432/liner
# Worker needs APP_SECRET to decrypt sealed credentials (Discogs token, AcoustID key)
# Must match the APP_SECRET from the API host's .env file
WORKER_APP_SECRET=<paste the same 32-byte random value used on the app host>
# Optional: override how the worker processes are restarted on the worker
# host. Leave unset for the built-in pidfile restart in scripts/deploy.sh
# (TERM → wait 30 s → KILL, ghost sweep, relaunch the two launcher scripts
# it expects in the worker user's home; read the script before relying on it).
# Set it for systemd or another supervisor, e.g.:
# WORKER_RESTART_CMD='systemctl restart tagave-worker-files tagave-worker-identify'
