# Copy to .deploy.env (gitignored). Hosts are ssh aliases from ~/.ssh/config.
APP_HOST=my-docker-host
APP_DIR=/home/me/liner
APP_HEALTH_URL=http://my-docker-host:3100/api/v1/health
WORKER_HOST=my-worker-host
WORKER_DIR=/root/liner
WORKER_NODE_BIN=/root/liner-node/node/bin
WORKER_DATABASE_URL=postgres://liner:liner@db-host:5432/liner
# restarts the worker processes on the worker host (pidfile launchers, systemd, …)
WORKER_RESTART_CMD='for p in liner-worker liner-identify; do kill $(cat ~/$p.pid) 2>/dev/null || true; done; sleep 4; nohup ~/liner-worker.sh > ~/liner-worker.log 2>&1 & echo $! > ~/liner-worker.pid; nohup ~/liner-identify.sh > ~/liner-identify.log 2>&1 & echo $! > ~/liner-identify.pid; sleep 8; for p in liner-worker liner-identify; do echo -n "$p: "; kill -0 $(cat ~/$p.pid) && echo alive || echo DEAD; done'
