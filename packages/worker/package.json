{
  "name": "@liner/worker",
  "version": "0.1.0",
  "type": "module",
  "description": "tagave music archive worker: scanning, clustering, matching, enrichment, tag writing",
  "_notes": {
    "python": "The tag writer sidecar requires Python 3.13+ with mutagen >=1.47. Set LINER_TAGWRITER_PYTHON env var to override the interpreter path, or use .venv/bin/python in packages/tagwriter-py."
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch --loader tsx dist/index.js"
  },
  "dependencies": {
    "@liner/core": "workspace:*",
    "@liner/db": "workspace:*",
    "@liner/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "music-metadata": "^11.16.0",
    "pg-boss": "^12.31.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}