{
  "name": "@tagave/worker",
  "version": "0.1.0",
  "type": "module",
  "description": "tagave music archive worker: scanning, clustering, matching, enrichment, tag writing",
  "_notes": {
    "python": "The tag writer sidecar requires Python 3.13+ with mutagen >=1.47. Set TAGAVE_TAGWRITER_PYTHON env var to override the interpreter path, or use .venv/bin/python in packages/tagwriter-py."
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch --loader tsx dist/index.js"
  },
  "dependencies": {
    "@tagave/core": "workspace:*",
    "@tagave/db": "workspace:*",
    "@tagave/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "music-connections": "workspace:*",
    "music-metadata": "^12.1.0",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
