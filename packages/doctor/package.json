{
  "name": "@liner/doctor",
  "version": "0.1.0",
  "type": "module",
  "description": "tagave diagnostics: health checks for database, workers, scan roots, providers, and configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "liner-doctor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@liner/auth": "workspace:*",
    "@liner/core": "workspace:*",
    "@liner/db": "workspace:*",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
