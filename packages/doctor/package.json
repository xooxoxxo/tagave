{
  "name": "@liner/doctor",
  "version": "0.1.0",
  "type": "module",
  "description": "Liner diagnostics: health checks for database, workers, scan roots, providers, and configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "liner-doctor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@liner/core": "workspace:*",
    "@liner/db": "workspace:*",
    "postgres": "^3.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
