{
  "name": "liner",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22.12" },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --parallel --filter @liner/api --filter @liner/web --filter @liner/worker dev",
    "db:migrate": "pnpm --filter @liner/db migrate"
  }
}
