{
  "name": "tagave",
  "private": true,
  "version": "0.13.1",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --parallel --filter @tagave/api --filter @tagave/web --filter @tagave/worker dev",
    "db:migrate": "pnpm --filter @tagave/db migrate",
    "doctor": "node packages/doctor/dist/cli.js doctor",
    "site:docs": "node scripts/site/build-docs.mjs"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.2"
    }
  },
  "devDependencies": {
    "marked": "18.1.1"
  }
}
