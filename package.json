{
  "name": "liner",
  "private": true,
  "version": "0.7.7",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --parallel --filter @liner/api --filter @liner/web --filter @liner/worker dev",
    "db:migrate": "pnpm --filter @liner/db migrate",
    "doctor": "node packages/doctor/dist/cli.js doctor"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.2"
    }
  }
}
