# ===== Tagave Installation =====
# This file is auto-generated by install-tagave.sh.
# Secrets are generated once and never regenerated.
# Back it up securely; keep it out of version control.

# ==== REQUIRED ====
# APP_SECRET: 32+ raw characters or 64+ hex characters (32+ bytes)
# Used for session signing and credential encryption (discogsToken, acoustidKey).
# Generate with: openssl rand -hex 32
APP_SECRET=

# ==== OPTIONAL (defaults shown) ====
# PUBLIC_URL: Public URL for OAuth redirects and CORS (e.g., https://music.example.com)
# PUBLIC_URL=http://localhost:3100

# LOG_LEVEL: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# ALLOW_INSECURE_HTTP: Allow HTTP cookies in development (default: false for production)
# ALLOW_INSECURE_HTTP=false

# ==== TOPOLOGY: SINGLE HOST ====
# Use if all services (API, Postgres, workers) run on the same machine
# MUSIC_DIR: Host path to your music library (will be mounted read-only in workers)
# Register the scan root as /mnt/music in the setup wizard.
# MUSIC_DIR=/path/to/music

# ==== TOPOLOGY: SPLIT (Workers on Different Host) ====
# WORKER_HOST: IP or hostname of worker machine (e.g., 192.168.1.20)
# DATABASE_URL: Connection string for workers to reach postgres on the app host
# Example: postgres://liner:password@app-host-ip:5432/liner
# WORKER_HOST=192.168.1.20
# DATABASE_URL=postgres://liner:password@app-host-ip:5432/liner

# ==== OPTIONAL: BACKUP ====
# BACKUP_ENABLED: Enable automated backups (default: false)
# BACKUP_SCHEDULE: Cron format for backup timing (e.g., "0 2 * * *" = 2 AM daily)
# BACKUP_ENABLED=false
# BACKUP_SCHEDULE=0 2 * * *
