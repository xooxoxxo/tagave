# Liner API Configuration

# Security
# APP_SECRET: required, 32+ bytes hex-encoded random data for session encryption
# Generate with: openssl rand -hex 32
APP_SECRET=

# Optional: public URL for OAuth redirects and CORS (e.g., https://music.example.com)
# PUBLIC_URL=

# Optional: log level (debug, info, warn, error)
# LOG_LEVEL=info
