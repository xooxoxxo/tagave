# tagave configuration

# Security
# APP_SECRET: required, 64+ hex characters (32+ bytes) or 32+ raw characters.
# Used for session signing and credential encryption (discogsToken, acoustidKey).
# Generate with: openssl rand -hex 32 (produces 64 characters for 32 bytes)
APP_SECRET=

# Optional: public URL for OAuth redirects and CORS (e.g., https://music.example.com)
# PUBLIC_URL=

# Optional: log level (debug, info, warn, error)
# LOG_LEVEL=info

# Optional: allow HTTP in development (default: requires HTTPS)
# ALLOW_INSECURE_HTTP=false

# Workers as Compose services (docker compose --profile workers up -d):
# host path of your music library, mounted read-only at /mnt/music in worker-files.
# Register the scan root as /mnt/music.
# MUSIC_DIR=/path/to/music

# Backups: before an update changes the database the app writes a checked
# pg_dump to /backups in its container (and refuses to update if that fails);
# `liner-doctor backup` writes there too. Default: the Docker volume "backups".
# Set a host folder to keep them outside Docker:
# BACKUP_DIR=/path/to/backups
# How many pre-update backups to keep (default 5):
# LINER_PREMIGRATE_BACKUP_KEEP=5
# Update without that backup (not recommended):
# LINER_SKIP_PREMIGRATE_BACKUP=1
