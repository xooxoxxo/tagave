# ===== Tagave Installation =====
# This file is auto-generated by install-tagave.sh.
# Secrets are generated once and never regenerated.
# Back it up securely; keep it out of version control.

# ==== REQUIRED ====
# APP_SECRET: 32-byte base64-encoded random string
# Used for JWT session signing and sealed credential encryption (Discogs token, AcoustID key)
# Generate with: openssl rand -32 | base64
# Example: "abcd1234+/==abcd1234+/==abcd1234+/=="
APP_SECRET=

# POSTGRES_PASSWORD: 32-byte base64-encoded random string
# Database connection password; keep secret
# Generate with: openssl rand -32 | base64
POSTGRES_PASSWORD=

# ==== DATABASE (auto-configured) ====
# POSTGRES_USER: Database user (hardcoded to 'liner')
# POSTGRES_DB: Database name (hardcoded to 'liner')
POSTGRES_USER=liner
POSTGRES_DB=liner

# ==== OPTIONAL: Network & URLs ====
# PUBLIC_URL: Full URL where this instance is accessible from the internet
# Used for reverse proxy / HTTPS, and in generated links (recovery emails, etc.)
# Default: http://localhost:3100
# Example: https://music.example.com or http://192.168.1.100:3100
PUBLIC_URL=http://localhost:3100

# ALLOW_INSECURE_HTTP: Allow HTTP cookies (for development only)
# Set to false for production HTTPS setups
# Default: true
ALLOW_INSECURE_HTTP=true

# ==== LOGGING & DEBUGGING ====
# LOG_LEVEL: info, debug, warn, or error
# Default: info
LOG_LEVEL=info

# ==== STORAGE ====
# CACHE_DIR: Where to store generated thumbnails, cache, and backups
# Inside Docker: /cache (mounted as a volume)
# Default: /cache
CACHE_DIR=/cache

# MUSIC_DIR: Path to music library (single-host topology only)
# Mounted read-only inside the worker container at /mnt/music
# Default: /mnt/music
# Examples: /home/user/Music, /mnt/nas/music, /Volumes/Music
MUSIC_DIR=/mnt/music

# ==== TOPOLOGY ====
# WORKER_TOPOLOGY: single-host or split
# - single-host: API, postgres, and workers all on the same machine
# - split: API and postgres on this host; workers on different machine(s)
# Default: single-host
WORKER_TOPOLOGY=single-host

# WORKER_HOST: IP address or hostname of worker machine (split topology only)
# Used during installer to validate worker can reach database
# Example: 192.168.1.20 or worker.local
# Not used in single-host topology
# WORKER_HOST=

# DATABASE_URL: Full postgres connection string for workers (split topology only)
# Only needed if WORKER_TOPOLOGY=split and workers are on a different machine
# Format: postgres://username:password@hostname:5432/database
# Example: postgres://liner:password@api-host.local:5432/liner
# DOCKER USERS: This is auto-set by docker-compose from other variables
# DATABASE_URL=postgres://liner:${POSTGRES_PASSWORD}@postgres:5432/liner

# ==== BACKUP & MAINTENANCE ====
# BACKUP_ENABLED: Enable automated database backups
# Default: false
BACKUP_ENABLED=false

# BACKUP_SCHEDULE: Cron schedule for automated backups
# Only used if BACKUP_ENABLED=true
# Format: minute hour day month day-of-week (cron format)
# Default: 0 2 * * * (daily at 2 AM UTC)
# Examples:
#   0 2 * * *     — daily at 2 AM
#   0 */6 * * *   — every 6 hours
#   30 3 * * 0    — weekly on Sunday at 3:30 AM
BACKUP_SCHEDULE=0 2 * * *

# BACKUP_LOCATION: Where to store backup files
# Inside Docker: /backup (mounted as a volume)
# Default: /backup
BACKUP_LOCATION=/backup

# ==== HOSTNAME & TIMEZONE ====
# HOSTNAME: Hostname or domain for this installation
# Used for service discovery and logging
# Default: tagave.local
# Examples: music.example.com, nas.local, homelab
HOSTNAME=tagave.local

# TIMEZONE: IANA timezone database name
# Used for scheduled jobs and log timestamps
# Default: UTC
# Examples: America/New_York, Europe/London, Asia/Tokyo
TIMEZONE=UTC

# ==== METRICS & MONITORING (future) ====
# METRICS_ENABLED: Enable Prometheus metrics collection
# Default: false
METRICS_ENABLED=false
