# /etc/tagave/worker.env for the tagave-worker-*.service units (mode 600).
# The same database and secret the app uses; APP_SECRET must match the app
# host's .env or sealed credentials (Discogs token, AcoustID key) won't open.
# the user and database your install has (liner on one set up before 0.9)
DATABASE_URL=postgres://tagave:change-me@db-host:5432/tagave
APP_SECRET=<the app's 64-hex-character APP_SECRET>
# Optional: pin one library, cap identify concurrency
# TAGAVE_LIBRARY_ID=
# IDENTIFY_CONCURRENCY=5
